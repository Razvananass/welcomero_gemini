{
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/**"
    },
    "api/sources-monitor.ts": {
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sources-monitor",
      "schedule": "0 6 * * *"
    }
  ]
}